# Server & Application
PORT=4000
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:4000
APP_TIMEZONE=Asia/Jakarta

# Database & Storage
DB_PATH=data/central.db
BACKUP_DIR=backups
LOG_DIR=logs

# Security & Session
SESSION_COOKIE_NAME=lab_central_sid
SESSION_TTL_HOURS=24
TOKEN_PEPPER=change-this-pepper-in-production-min-32-chars

# Default Bootstrap Admin (digunakan saat tabel users masih kosong)
ADMIN_EMAIL=admin@lab.kampus.ac.id
ADMIN_PASSWORD=AdminLab!2026
ADMIN_NAME=Administrator Utama

# Operational Thresholds
LAB_SILENT_MINUTES=15
CLOCK_SKEW_ALERT_SECONDS=300
PENDING_BACKLOG_WARNING=50
INGEST_RATE_LIMIT_PER_MIN=120
